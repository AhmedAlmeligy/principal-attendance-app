# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# PostHog product analytics (optional). Leave the key empty to disable
# analytics entirely — the app then behaves exactly as before.
# The project API key starts with "phc_" and is safe to ship in the client.
VITE_POSTHOG_KEY=
# Defaults to the US cloud; use https://eu.i.posthog.com for EU projects.
VITE_POSTHOG_HOST=
